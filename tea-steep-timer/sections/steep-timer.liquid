    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your ideal steep, timed to the second."
    },
    {
      "type": "checkbox",
      "id": "show_fahrenheit",
      "label": "Show Fahrenheit",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "chime",
      "label": "Play chime when ready",
      "default": true
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "default": "#c8812a"
    }
  ],
  "blocks": [
    {
      "type": "tea",
      "name": "Tea",
      "settings": [
        {
          "type": "text",
          "id": "tea_type",
          "label": "Tea type (matches product type)",
          "default": "green"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Green tea"
        },
        {
          "type": "range",
          "id": "temp_c",
          "label": "Water temperature (C)",
          "min": 60,
          "max": 100,
          "step": 1,
          "unit": "C",
          "default": 80
        },
        {
          "type": "range",
          "id": "seconds",
          "label": "Steep time (seconds)",
          "min": 30,
          "max": 600,
          "step": 10,
          "unit": "s",
          "default": 120
        },
        {
          "type": "number",
          "id": "grams_per_cup",
          "label": "Leaf per cup (grams)",
          "default": 2.5
        },
        {
          "type": "range",
          "id": "infusions",
          "label": "Infusions",
          "min": 1,
          "max": 8,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "increment_seconds",
          "label": "Extra seconds per infusion",
          "min": 0,
          "max": 120,
          "step": 5,
          "unit": "s",
          "default": 30
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Brewing note",
          "default": "Soft water, gentle pour."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steep timer",
      "blocks": [
        {
          "type": "tea",
          "settings": {
            "tea_type": "green",
            "label": "Green tea",
            "temp_c": 80,
            "seconds": 120,
            "grams_per_cup": 2.5,
            "infusions": 3,
            "increment_seconds": 30,
            "note": "Soft water, gentle pour. Leaves unfurl slowly."
          }
        },
        {
          "type": "tea",
          "settings": {
            "tea_type": "black",
            "label": "Black tea",
            "temp_c": 95,
            "seconds": 240,
            "grams_per_cup": 2.5,
            "infusions": 1,
            "increment_seconds": 0,
            "note": "Full boil, brisk and bright."
          }
        },
        {
          "type": "tea",
          "settings": {
            "tea_type": "oolong",
            "label": "Oolong tea",
            "temp_c": 90,
            "seconds": 60,
            "grams_per_cup": 5,
            "infusions": 5,
            "increment_seconds": 15,
            "note": "Many short infusions reward patience."
          }
        },
        {
          "type": "tea",
          "settings": {
            "tea_type": "herbal",
            "label": "Herbal / Chamomile",
            "temp_c": 100,
            "seconds": 300,
            "grams_per_cup": 2,
            "infusions": 1,
            "increment_seconds": 0,
            "note": "Cover the cup to keep the aromatics in."
          }
        },
        {
          "type": "tea",
          "settings": {
            "tea_type": "white",
            "label": "White tea",
            "temp_c": 85,
            "seconds": 180,
            "grams_per_cup": 3,
            "infusions": 2,
            "increment_seconds": 60,
            "note": "Delicate: cooler water, longer wait."
          }
        }
      ]
    }
  ]
}
{% endschema %}
