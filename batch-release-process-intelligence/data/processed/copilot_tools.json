 {
  "name": "get_kpis",
  "description": "Aggregate release KPIs over closed batches in scope, optionally versus a comparison scope.",
  "parameters": {
   "type": "object",
   "required": [
    "filters"
   ],
   "properties": {
    "filters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "site": {
       "type": "string",
